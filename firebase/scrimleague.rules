    // ---------- Dota Scrim League ----------
    //
    // A separate app in the same project, namespaced under scrimLeague/ so it cannot
    // collide with recipes, collections or Maze Racer. Source of truth for this block:
    // the Dota Scrim League repo, firebase/scrimleague.rules (merged in with
    // scripts/rules/merge-rules.cjs).
    //
    // Matches are uploaded by anonymous-auth clients after the uploader reviews what OCR
    // read from their post-game screenshots, so these rules are the only thing standing
    // between the league tables and junk. They check shape and plausible values; they do
    // not (cannot) prove a scoreboard is real.
    // These collections share the same rules: `matches` (scrims), and `ad2l_unticketed`
    // (Champion), `heroic_unticketed` (Heroic/Aegis), `conqueror_unticketed`, `warrior_unticketed`, `challenger_unticketed`, `voyager_unticketed` and `explorer_unticketed`: AD2L
    // division games played without a league ticket, uploaded from screenshots the same way.
    match /scrimLeague/data/{coll}/{matchId} {

      // One regex, not a list: every list element counts against the expression budget
      // below, and the fifth collection pushed the worst-case upload over 1000.
      function knownColl() { return coll.matches('matches|(ad2l|heroic|conqueror|warrior|challenger|voyager|explorer)_unticketed'); }

      // Anyone may read: the league tables are the point. The limit bound applies to
      // `list` because Firestore evaluates it against the query's potential result set.
      allow get: if knownColl();
      allow list: if knownColl() && request.query.limit <= 500;

      // BUDGET: Firestore stops evaluating after 1000 expressions per request, and every
      // field read, operator and literal counts. Ten players with a range check per field
      // blow straight through it (measured with the rules test API, scripts/rules/rules-dry-test.cjs).
      // So each check is made to do several jobs at once:
      //  - keys().size() == 15 plus reading all 15 named fields below proves the exact
      //    field set without a 15-element hasOnly list;
      //  - one sum over every stat is `is int`: a string errors (-> deny) and a float fails;
      //  - one sum of the two name lengths errors unless both are strings, and caps them.
      // Per-field ranges (no negative kills etc.) are enforced by the upload form, not here;
      // a hand-crafted request could slip one past, and the admin can delete it.
      // Optional 16th field `pick`: draft order from the Scoreboard's PICK column. The key
      // count must be 16 exactly when it's there (so it can't stand in for a stat or sneak
      // in another field), and it joins the `is int` sum; its 1-10 range is the form's job.
      // Re-run the dry test after ANY change here: the valid case sits near the limit.
      function validPlayer(p, team) {
        return p.size() == ('pick' in p ? 16 : 15)
          && p.team == team
          && (p.level + p.kills + p.deaths + p.assists + p.net_worth + p.last_hits + p.denies
              + p.gpm + p.xpm + p.hero_damage + p.hero_healing + p.get('pick', 0)) is int
          && p.name.size() + p.hero.size() <= 64
          && p.level <= 30;
      }

      // Private scrims are results only: the same fields minus `players` (11 keys; every
      // one is read here or in the create rule, so the count proves the exact set).
      // Public scrims add the ten players (12 keys).
      // `series_id`: the PlayOn series an unticketed AD2L game fills, one more key. Required
      // in the unticketed collections (only missing games may be uploaded), not allowed in matches.
      // Whether that series really is missing a game is the form's job, like the stat ranges.
      function validMatch(d) {
        return d.v == 2
          && d.private is bool
          && validResult(d)
          // A bad or missing series_id makes the count 99 so it can't match.
          && d.size() == (d.private ? 11 : 12)
               // (knownColl() has already limited coll to the known ones, so != 'matches' means
               // an unticketed collection, at the cost of one comparison.)
               + ('series_id' in d ? (coll != 'matches' && d.series_id is int ? 1 : 99)
                                   : (coll != 'matches' ? 99 : 0))
          && (d.private || validPlayers(d));
      }

      function validResult(d) {
        return d.team_a.size() + d.team_b.size() <= 80
          && d.team_a.lower() != d.team_b.lower()
          && d.score_a + d.score_b is int
          && d.score_a + d.score_b <= 400
          && d.winner in ['a', 'b']
          && d.duration_sec is int && d.duration_sec >= 120 && d.duration_sec <= 14400
          && d.game_mode.size() <= 40;
      }

      function validPlayers(d) {
        // Five a side, team A first: the order the upload form always sends.
        return d.players.size() == 10
          && validPlayer(d.players[0], 'a') && validPlayer(d.players[1], 'a')
          && validPlayer(d.players[2], 'a') && validPlayer(d.players[3], 'a')
          && validPlayer(d.players[4], 'a') && validPlayer(d.players[5], 'b')
          && validPlayer(d.players[6], 'b') && validPlayer(d.players[7], 'b')
          && validPlayer(d.players[8], 'b') && validPlayer(d.players[9], 'b');
      }

      // The document ID is a hash of the game (teams, kill score, duration -- no heroes, so
      // a private scrim's ID reveals nothing), computed by the client, so two uploads of the
      // same game collide on one ID. Create-only plus that collision is what stops the same
      // scrim being counted twice. uid pins who uploaded it; createdAt must be the server's
      // clock, not the client's.
      allow create: if knownColl() && request.auth != null
        && matchId.matches('[0-9a-f]{32}')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validMatch(request.resource.data);

      // Editing (e.g. fixing a misread name): same checks as a new upload, and the uploader,
      // upload time, private flag and series stay as they were. Open to anyone signed in,
      // like delete; the site puts it behind the same shared password. One diff() instead of
      // four comparisons: the player checks leave little of the expression budget.
      allow update: if knownColl() && request.auth != null
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'createdAt', 'private', 'series_id'])
        && validMatch(request.resource.data);

      // Anyone signed in (the site signs visitors in anonymously) may delete an upload: the
      // league decided a wrong or fake upload should be easy to remove. The site asks for a
      // shared password first, which is a speed bump only; the rules don't check it.
      allow delete: if knownColl() && request.auth != null;
    }

    // Predictions: one document per person per series (AD2L) or scrim fixture, id "<series id>_<uid>", so each
    // browser can make and change one pick per series. updatedAt must be the server's clock:
    // scoring ignores picks stamped after the series started, so a late change can't count.
    // `name` is whatever the predictor typed (standings group by it); nothing else is stored.
    match /scrimLeague/data/predictions/{predId} {
      allow get: if true;
      allow list: if request.query.limit <= 5000;
      allow create, update: if request.auth != null
        && predId == string(request.resource.data.series_id) + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['v', 'league', 'series_id', 'pick', 'name', 'uid', 'updatedAt'])
        && request.resource.data.keys().size() == 7
        && request.resource.data.v == 1
        // AD2L picks (Champion "ad2l", "heroic", "conqueror", "warrior", "challenger", "voyager", "explorer") are on PlayOn series (int ids); scrim picks
        // on a fixture's document ID.
        && (request.resource.data.league in ['ad2l', 'heroic', 'conqueror', 'warrior', 'challenger', 'voyager', 'explorer']
              ? request.resource.data.series_id is int
              : request.resource.data.league == 'scrim'
                && request.resource.data.series_id is string
                && request.resource.data.series_id.matches('[A-Za-z0-9]{20}'))
        && request.resource.data.pick in ['home', 'tie', 'away']
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.uid || request.auth.token.email == "jonahbyu@gmail.com");
    }

    // Brackets: a person's playoff bracket picks for one AD2L league, shown on the Predict
    // leaderboard. One document per person per league, id "<league>_<uid>". `picks` is JSON
    // text ({ key: team id }); the site reads it defensively, so only its size is checked.
    match /scrimLeague/data/brackets/{bracketId} {
      allow get: if true;
      allow list: if request.query.limit <= 500;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['v', 'league', 'name', 'uid', 'picks', 'updatedAt'])
        && request.resource.data.keys().size() == 6
        && request.resource.data.v == 1
        && request.resource.data.league in ['ad2l', 'heroic', 'conqueror', 'warrior', 'challenger', 'voyager', 'explorer']
        && bracketId == request.resource.data.league + '_' + request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.picks is string && request.resource.data.picks.size() <= 3000
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.uid || request.auth.token.email == "jonahbyu@gmail.com");
    }

    // Fantasy entries: one per person per AD2L league per week, id "<league>_<week>_<account>".
    // Only a Steam sign-in (uid "steam:<account>", minted by workers/steam-auth with the account
    // as the `steam` claim) can write, and only its own entry. picks: five distinct account ids,
    // slot 1 first, never the picker's own. Lock and eligibility are checked when scoring:
    // updatedAt must be the server's clock, and entries saved after the week's first series
    // start never count (as with predictions).
    match /scrimLeague/data/fantasy/{entryId} {
      allow get: if true;
      allow list: if request.query.limit <= 5000;
      allow create, update: if request.auth != null
        && request.auth.token.steam is int
        && request.auth.uid == 'steam:' + string(request.auth.token.steam)
        && request.resource.data.keys().hasOnly(['v', 'league', 'week', 'account', 'picks', 'captain', 'name', 'uid', 'updatedAt'])
        && request.resource.data.keys().size() in [8, 9]
        && (!('captain' in request.resource.data) || (request.resource.data.captain is int && request.resource.data.captain in request.resource.data.picks))
        && request.resource.data.v == 1
        && request.resource.data.league in ['all', 'ad2l', 'heroic', 'conqueror', 'warrior', 'challenger', 'voyager', 'explorer']
        && request.resource.data.week is string && request.resource.data.week.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.account == request.auth.token.steam
        && entryId == request.resource.data.league + '_' + request.resource.data.week + '_' + string(request.auth.token.steam)
        && request.resource.data.picks is list && request.resource.data.picks.size() == 5
        && request.resource.data.picks.toSet().size() == 5
        && request.resource.data.picks[0] is int && request.resource.data.picks[1] is int && request.resource.data.picks[2] is int
        && request.resource.data.picks[3] is int && request.resource.data.picks[4] is int
        && !(request.auth.token.steam in request.resource.data.picks)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.uid || request.auth.token.email == "jonahbyu@gmail.com");
    }

    // Player cards: a player's own choices for their Fantasy card, id "<account>". Only that
    // account's Steam sign-in can write it. hero: a hero id (null = their most played), pos: the
    // role they play now, 1–5 (null = their most played position).
    match /scrimLeague/data/cards/{cardId} {
      allow get: if true;
      allow list: if request.query.limit <= 5000;
      allow create, update: if request.auth != null
        && request.auth.token.steam is int
        && request.auth.uid == 'steam:' + string(request.auth.token.steam)
        && cardId == string(request.auth.token.steam)
        && request.resource.data.keys().hasOnly(['v', 'account', 'hero', 'pos', 'art', 'style', 'crop', 'uid', 'updatedAt'])
        && request.resource.data.keys().hasAll(['v', 'account', 'hero', 'pos', 'uid', 'updatedAt'])
        && request.resource.data.v == 1
        && request.resource.data.account == request.auth.token.steam
        && (request.resource.data.hero == null || (request.resource.data.hero is int && request.resource.data.hero >= 1 && request.resource.data.hero <= 300))
        && (request.resource.data.pos == null || (request.resource.data.pos is int && request.resource.data.pos >= 1 && request.resource.data.pos <= 5))
        && (request.resource.data.get('art', null) == null
          || (request.resource.data.art is string && request.resource.data.art.matches('(vert|crop|render|ls:[0-9a-f]{12})')))
        && (request.resource.data.get('style', null) == null
          || request.resource.data.style in ['stencil', 'clean', 'cinema', 'ember', 'frost', 'comic', 'ink', 'noir'])
        && (request.resource.data.get('crop', null) == null
          || (request.resource.data.crop is map && request.resource.data.crop.keys().hasOnly(['x', 'y', 'zoom'])
            && request.resource.data.crop.keys().size() == 3
            && request.resource.data.crop.x is number && request.resource.data.crop.x >= 0 && request.resource.data.crop.x <= 100
            && request.resource.data.crop.y is number && request.resource.data.crop.y >= 0 && request.resource.data.crop.y <= 100
            && request.resource.data.crop.zoom is number && request.resource.data.crop.zoom >= 1 && request.resource.data.crop.zoom <= 3))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.uid || request.auth.token.email == "jonahbyu@gmail.com");
    }

    // Scrim fixtures: upcoming scrims anyone can put on the schedule for predictions. Only
    // teams, start time and format; results come from uploaded games (matched by teams and
    // time on the client). Rescheduling changes start/best_of only; delete is open to anyone
    // signed in, behind the same shared password on the site as deleting a game.
    match /scrimLeague/data/scrim_fixtures/{fixtureId} {
      function validFixture(d) {
        return d.keys().hasOnly(['v', 'team_a', 'team_b', 'start', 'best_of', 'uid', 'createdAt'])
          && d.keys().size() == 7
          && d.v == 1
          && d.team_a is string && d.team_b is string
          && d.team_a.size() >= 1 && d.team_a.size() <= 40
          && d.team_b.size() >= 1 && d.team_b.size() <= 40
          && d.team_a.lower() != d.team_b.lower()
          && d.start is timestamp
          && d.best_of in [1, 2, 3];
      }
      allow get: if true;
      allow list: if request.query.limit <= 500;
      // Start between 2 days ago (logging a scrim just played) and 60 days ahead.
      allow create: if request.auth != null
        && fixtureId.matches('[A-Za-z0-9]{20}')
        && validFixture(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.start > request.time - duration.value(2, 'd')
        && request.resource.data.start < request.time + duration.value(60, 'd');
      allow update: if request.auth != null
        && validFixture(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['start', 'best_of'])
        && request.resource.data.start < request.time + duration.value(60, 'd');
      allow delete: if request.auth != null;
    }

    // Casts: links to a cast of a game with the caster's name, shown on the game page.
    // `game` is the page's ID (OpenDota match ID or 32-hex upload ID), `league` the division
    // key. No updates (delete and add again). Delete is open to anyone signed in; the site
    // lets whoever added a cast remove it and puts everyone else behind the league password.
    match /scrimLeague/data/casts/{castId} {
      allow get: if true;
      allow list: if request.query.limit <= 20;
      allow create: if request.auth != null
        && castId.matches('[A-Za-z0-9]{20}')
        && request.resource.data.keys().hasOnly(['v', 'league', 'game', 'url', 'caster', 'uid', 'createdAt'])
        && request.resource.data.keys().size() == 7
        && request.resource.data.v == 1
        && request.resource.data.league in ['scrim', 'ad2l', 'heroic', 'conqueror', 'warrior', 'challenger', 'voyager', 'explorer']
        && request.resource.data.game is string
        && request.resource.data.game.matches('[0-9]{1,15}|[0-9a-f]{32}')
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 300
        // Printable ASCII minus space, " < and > (the site sends URL().href, which encodes the rest).
        && request.resource.data.url.matches('https://[!#-;=?-~]+')
        && request.resource.data.caster is string
        && request.resource.data.caster.size() >= 1 && request.resource.data.caster.size() <= 40
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null;
    }
    // Feedback: anyone can mark up the site and send a ticket (lib/feedback.js). A ticket
    // is one review session; its items (one per mark + note, with a cropped screenshot)
    // sit in a subcollection because eight screenshots won't fit in one 1 MiB document.
    // The site can only create. Reading and deleting happen outside the app with Jonah's
    // Google credentials (not bound by these rules); the email exception is for a future
    // admin view. Tickets hold names and screenshots, so they aren't public.
    match /scrimLeague/data/feedback/{ticketId} {
      function admin() { return request.auth != null && request.auth.token.email == "jonahbyu@gmail.com"; }
      allow get, list, delete: if admin();
      // Written in one batch with the rate limiter below, which must name this ticket.
      allow create: if request.auth != null
        && ticketId.matches('[A-Za-z0-9]{20}')
        && request.resource.data.keys().hasOnly(['v', 'name', 'uid', 'items', 'status', 'createdAt'])
        && request.resource.data.keys().size() == 6
        && request.resource.data.v == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.items is int
        && request.resource.data.items >= 1 && request.resource.data.items <= 10
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/scrimLeague/data/feedback_limits/$(request.auth.uid)).data.last == ticketId;

      // One item per mark: where it was (page, league, theme, viewport), what kind of mark,
      // the note, the marked area and a JPEG of it. Only in the batch that creates the
      // ticket: the ticket mustn't exist before and must exist after, from the same uid.
      match /items/{n} {
        allow get, list, delete: if admin();
        allow create: if request.auth != null
          && n.matches('[0-9]')
          && !exists(/databases/$(database)/documents/scrimLeague/data/feedback/$(ticketId))
          && int(n) < getAfter(/databases/$(database)/documents/scrimLeague/data/feedback/$(ticketId)).data.items
          && getAfter(/databases/$(database)/documents/scrimLeague/data/feedback/$(ticketId)).data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['v', 'kind', 'page', 'league', 'theme', 'viewport', 'note', 'area', 'target', 'strokes', 'shot', 'uid', 'createdAt'])
          && request.resource.data.keys().size() == 13
          && request.resource.data.v == 1
          && request.resource.data.kind in ['snip', 'click', 'draw']
          // The full address, e.g. https://…/warrior/players/?tab=tiers (the site's hosts only).
          && request.resource.data.page is string && request.resource.data.page.size() <= 400
          && request.resource.data.page.matches('(https://dota2scrimcircuittracker[.]github[.]io|http://localhost:[0-9]+)/[!#-;=?-~]*')
          && request.resource.data.league is string && request.resource.data.league.size() <= 20
          && request.resource.data.theme in ['dark', 'grey', 'light']
          && request.resource.data.viewport is map && request.resource.data.viewport.keys().hasOnly(['w', 'h'])
          && request.resource.data.note is string
          && request.resource.data.note.size() >= 1 && request.resource.data.note.size() <= 1000
          && request.resource.data.area is map && request.resource.data.area.keys().hasOnly(['x', 'y', 'w', 'h'])
          // Click: the element's CSS selector and visible text. Otherwise null.
          && (request.resource.data.target == null
            || (request.resource.data.target is map && request.resource.data.target.keys().hasOnly(['sel', 'text'])
              && request.resource.data.target.sel is string && request.resource.data.target.sel.size() <= 400
              && request.resource.data.target.text is string && request.resource.data.target.text.size() <= 200))
          // Draw: the pen strokes as an SVG path in page coordinates. Otherwise null.
          && (request.resource.data.strokes == null
            || (request.resource.data.strokes is string && request.resource.data.strokes.size() <= 20000))
          // null when the capture failed; the selector and area still say where.
          && (request.resource.data.shot == null
            || (request.resource.data.shot is string && request.resource.data.shot.size() <= 700000
              && request.resource.data.shot.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time;
      }
    }

    // Feedback rate limit: 5 tickets per browser (anonymous uid) per rolling hour. Five
    // timestamp slots used as a ring; `i` is the next slot to fill, which is also the oldest.
    // Empty slots hold the 1970 epoch. A ticket may take slot i only if it's over an hour old, and the limiter's
    // `last` must name a ticket created in the same batch, so every ticket spends one slot.
    // (Timestamps sit in separate fields because serverTimestamp() can't go inside an array.)
    match /scrimLeague/data/feedback_limits/{uid} {
      function lastIsNewTicket() {
        return request.resource.data.last is string
          && request.resource.data.last.matches('[A-Za-z0-9]{20}')
          && !exists(/databases/$(database)/documents/scrimLeague/data/feedback/$(request.resource.data.last))
          && existsAfter(/databases/$(database)/documents/scrimLeague/data/feedback/$(request.resource.data.last));
      }
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t0', 't1', 't2', 't3', 't4', 'i', 'last'])
        && request.resource.data.keys().size() == 7
        && request.resource.data.t0 == request.time
        && request.resource.data.t1 == timestamp.value(0) && request.resource.data.t2 == timestamp.value(0)
        && request.resource.data.t3 == timestamp.value(0) && request.resource.data.t4 == timestamp.value(0)
        && request.resource.data.i == 1
        && lastIsNewTicket();
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['t' + string(resource.data.i), 'i', 'last'])
        && request.resource.data['t' + string(resource.data.i)] == request.time
        && resource.data['t' + string(resource.data.i)] < request.time - duration.value(1, 'h')
        && request.resource.data.i == (resource.data.i + 1) % 5
        && lastIsNewTicket();
    }
